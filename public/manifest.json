{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "HOSentinel",
  "short_name": "HOSentinel",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#111827",
  "background_color": "#f3f4f6",
